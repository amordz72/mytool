{
  "schema_version": 1,
  "policy_id": "mytool-flexy-current",
  "updated_at": "2026-09-22",
  "authority": {
    "repository": "amordz72/mytool-dev",
    "path": "flexy/policy",
    "precedence": [
      "current_policy",
      "current_code_and_schema",
      "dated_live_evidence",
      "legacy_project_docs"
    ],
    "chat_memory_is_source_of_truth": false
  },
  "offer_identity": {
    "fields": [
      "operator",
      "family",
      "amount"
    ],
    "supersedes": "SimType + Family + Amount"
  },
  "layers": [
    "operator",
    "offer_identity",
    "knowledge_source",
    "presentation_policy",
    "execution_route",
    "routing_policy",
    "physical_resource",
    "readiness",
    "execution_decision",
    "recharge"
  ],
  "invariants": {
    "discovery_is_execution": false,
    "presentation_depends_on_execution_availability": false,
    "observed_sim_implies_executor": false,
    "hardcode_amount_to_source": false,
    "invent_unregistered_sim_source": false,
    "recharge_stock_is_global_offer_gate": false
  },
  "routing": {
    "mutable_source": "database",
    "candidate_requires": [
      "route.enabled",
      "route.verified",
      "supported",
      "physical_sim_present",
      "resource_online",
      "secret_available",
      "successful_balance_baseline_present",
      "operational_balance_sufficient"
    ],
    "order_by": [
      "policy_priority",
      "readiness"
    ],
    "no_candidate": "do_not_invent_route",
    "execution_decision_required": true
  },
  "mobilis_sama": {
    "index_scope": "SAMA execution only",
    "execution_flow": [
      "family_route",
      "service_pin",
      "first_offer_page",
      "final_network_index"
    ],
    "navigation_codes_for_discovery_only": [
      "0",
      "00"
    ]
  },
  "mobilis_arsselli": {
    "template": "*696*1*{phone}*{distributor_account}*{amount}*{PIN}#",
    "uses_sama_network_index": false,
    "distributor_accounts": {
      "04": "GTS",
      "05": "MOBILIS"
    },
    "save_actual_account_per_execution": true,
    "support_evidence_date": "2026-08-29",
    "supported": [
      "Revolution",
      "PixX",
      "Sama Mix"
    ],
    "unsupported": [
      "Sama Talk",
      "Sama Net"
    ]
  },
  "recharge": {
    "role": "execution_source_readiness",
    "mobilis_card_amounts": [
      1000,
      2000
    ],
    "blocks_all_offer_routes": false
  },
  "agent": {
    "thin_transport": true,
    "business_routing_logic": false,
    "secrets_in_git": false
  },
  "balance_policy": {
    "baseline_required": true,
    "baseline_expires_by_age": false,
    "lookup_before_every_execution": false,
    "operational_balance_model": "network_baseline + confirmed_inflows - confirmed_outflows",
    "reconciliation": {
      "amount_threshold_dzd_default": 20000,
      "threshold_is_configurable": true,
      "time_trigger_blocks_execution": false,
      "triggers": [
        "cumulative_amount_threshold",
        "network_or_sim_recovery",
        "ambiguous_financial_result",
        "known_external_recharge_or_adjustment",
        "scheduled_background_check"
      ]
    },
    "mobilis_arsselli": {
      "successful_execution_outflow": "amount",
      "fixed_execution_fee_dzd": 0
    },
    "mobilis_sama": {
      "successful_execution_outflow": "offer_amount + fixed_execution_fee",
      "fixed_execution_fee_dzd": 10
    },
    "failed_execution_outflow": 0,
    "review_execution_finalizes_outflow": false
  }
}
